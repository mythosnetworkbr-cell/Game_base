CMD:reviver(playerid, params[]) { if(!NYX_AdminHas(playerid,1)) return NYX_AdminDeny(playerid); new id; if(sscanf(params,"i",id)||!IsPlayerConnected(id)) return SendClientMessage(playerid,COLOR_ERROR,"Uso: /reviver [playerid]"); SetPlayerHealth(id,100.0); return SendClientMessage(playerid,COLOR_SUCCESS,"Jogador revivido."); }
