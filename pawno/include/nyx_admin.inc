CMD:respawncars(playerid, params[]) { if(!NYX_AdminHas(playerid,1)) return NYX_AdminDeny(playerid); for(new v=1;v<MAX_VEHICLES;v++) SetVehicleToRespawn(v); return SendClientMessage(playerid,COLOR_SUCCESS,"Veiculos respawnados."); }
