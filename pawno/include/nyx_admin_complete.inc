stock bool:NYX_AdminHas(playerid,level){return NYX_Player[playerid][NYX_Admin]>=level;}
stock NYX_AdminDeny(playerid){return SendClientMessage(playerid,COLOR_ERROR,"NYX: voce nao possui permissao para este comando.");}
stock NYX_AdminFirstId(const text[],&id){if(text[0]==EOS)return 0;id=strval(text);return id>=0&&id<MAX_PLAYERS;}
stock NYX_AdminTail(const text[],out[],out_size){new p=strfind(text," ",true);if(p<0){out[0]=EOS;return 0;}format(out,out_size,"%s",text[p+1]);return 1;}
stock NYX_AdminIdReason(const text[],&id,reason[],reason_size){new tail[128];if(!NYX_AdminFirstId(text,id))return 0;if(!NYX_AdminTail(text,tail,sizeof tail))return 0;format(reason,reason_size,"%s",tail);return 1;}
stock NYX_AdminIdMinutesReason(const text[],&id,&minutes,reason[],reason_size){new p1=strfind(text," ",true),rest[128],p2;if(p1<1)return 0;id=strval(text);if(id<0||id>=MAX_PLAYERS)return 0;format(rest,sizeof rest,"%s",text[p1+1]);p2=strfind(rest," ",true);if(p2<1)return 0;minutes=strval(rest);format(reason,reason_size,"%s",rest[p2+1]);return 1;}
stock NYX_AdminLog(playerid,targetid,const command[],const details[]){new path[96],line[256],adminName[MAX_PLAYER_NAME],targetName[MAX_PLAYER_NAME],File:file;GetPlayerName(playerid,adminName,sizeof adminName);if(targetid!=INVALID_PLAYER_ID&&IsPlayerConnected(targetid))GetPlayerName(targetid,targetName,sizeof targetName);else format(targetName,sizeof targetName,"SERVER");format(path,sizeof path,"scriptfiles/nyx_admin_logs.dat");file=fopen(path,io_append);if(!file)return 0;format(line,sizeof line,"%d | %s | %s | %s | %s",gettime(),adminName,targetName,command,details);fwrite(file,line);fclose(file);return 1;}
stock NYX_AdminSave(playerid){NYX_SaveAccount(playerid);return 1;}
stock NYX_AdminJailPlayer(targetid,seconds,const reason[]){NYX_AdminJail[targetid]=seconds;format(NYX_AdminJailReason[targetid],64,"%s",reason);SetPlayerPos(targetid,NYX_JAIL_X,NYX_JAIL_Y,NYX_JAIL_Z);SetPlayerFacingAngle(targetid,NYX_JAIL_A);SetPlayerInterior(targetid,NYX_JAIL_INTERIOR);SetPlayerVirtualWorld(targetid,NYX_JAIL_WORLD);ResetPlayerWeapons(targetid);TogglePlayerControllable(targetid,1);return 1;}
stock NYX_AdminReleaseJail(targetid){NYX_AdminJail[targetid]=0;NYX_AdminJailReason[targetid][0]=EOS;SetPlayerInterior(targetid,0);SetPlayerVirtualWorld(targetid,0);SetPlayerPos(targetid,NYX_SPAWN_X,NYX_SPAWN_Y,NYX_SPAWN_Z);TogglePlayerControllable(targetid,1);return 1;}
stock NYX_AdminPayday(playerid){new salary=NYX_PAYDAY_BASE,msg[144];if(NYX_Player[playerid][NYX_Admin]>0)salary+=NYX_ADMIN_PAYDAY_BONUS;NYX_Bank[playerid]+=salary;NYX_PaydayTime[playerid]=0;PlayerPlaySound(playerid,1058,0.0,0.0,0.0);SendClientMessage(playerid,COLOR_SUCCESS,"========== [ EXTRATO BANCARIO - PAYDAY ] ==========");format(msg,sizeof msg,"Salario recebido: $%d (depositado no banco).",salary);SendClientMessage(playerid,COLOR_WHITE,msg);format(msg,sizeof msg,"Saldo total no banco: $%d",NYX_Bank[playerid]);SendClientMessage(playerid,COLOR_WHITE,msg);SendClientMessage(playerid,COLOR_SUCCESS,"====================================================");NYX_SaveAccount(playerid);return 1;}
forward NYX_AdminSecondTick();
public NYX_AdminSecondTick(){for(new i=0;i<MAX_PLAYERS;i++){if(!IsPlayerConnected(i)||!NYX_Player[i][NYX_Logged])continue;if(NYX_AdminJail[i]>0){NYX_AdminJail[i]--;if(GetPlayerWeapon(i)>0)ResetPlayerWeapons(i);if(NYX_AdminJail[i]<=0){NYX_AdminReleaseJail(i);SendClientMessage(i,COLOR_SUCCESS,"[PRISAO]: Sua pena terminou. Voce foi liberado.");NYX_AdminSave(i);}}NYX_PaydayTime[i]++;if(NYX_PaydayTime[i]>=NYX_PAYDAY_SECONDS)NYX_AdminPayday(i);}return 1;}
stock NYX_AdminInit(){NYX_AdminTimer=SetTimer("NYX_AdminSecondTick",1000,true);for(new i=0;i<MAX_PLAYERS;i++){NYX_AdminGod[i]=false;NYX_AdminInvisible[i]=false;NYX_AdminFrozen[i]=false;NYX_AdminJail[i]=0;NYX_AdminWarnings[i]=0;NYX_PaydayTime[i]=0;NYX_AdminJailReason[i][0]=EOS;}return 1;}
stock NYX_AdminShutdown(){if(NYX_AdminTimer)KillTimer(NYX_AdminTimer);NYX_AdminTimer=0;return 1;}
stock NYX_AdminConnect(playerid){NYX_AdminGod[playerid]=false;NYX_AdminInvisible[playerid]=false;NYX_AdminFrozen[playerid]=false;NYX_AdminJail[playerid]=0;NYX_AdminWarnings[playerid]=0;NYX_PaydayTime[playerid]=0;NYX_AdminJailReason[playerid][0]=EOS;return 1;}
stock NYX_AdminDisconnect(playerid){NYX_AdminGod[playerid]=false;NYX_AdminInvisible[playerid]=false;NYX_AdminFrozen[playerid]=false;NYX_AdminJail[playerid]=0;NYX_AdminWarnings[playerid]=0;NYX_PaydayTime[playerid]=0;NYX_AdminJailReason[playerid][0]=EOS;return 1;}
stock NYX_AdminCommand(playerid,cmdtext[])
{
    new id,minutes,reason[64],msg[160];
    if(!NYX_Player[playerid][NYX_Logged])return 0;
    if(!strcmp(cmdtext,"/a",true,2)&&cmdtext[2]==' '){if(!NYX_AdminHas(playerid,1))return NYX_AdminDeny(playerid);new name[MAX_PLAYER_NAME];GetPlayerName(playerid,name,sizeof name);format(msg,sizeof msg,"[CHAT STAFF] %s %s: %s",NYX_Player[playerid][NYX_Admin]>=80?"DEV":"STAFF",name,cmdtext[3]);for(new i=0;i<MAX_PLAYERS;i++)if(IsPlayerConnected(i)&&NYX_Player[i][NYX_Logged]&&NYX_Player[i][NYX_Admin]>0)SendClientMessage(i,0xFFFF00FF,msg);return 1;}
    if(!strcmp(cmdtext,"/ir",true,3)){if(!NYX_AdminHas(playerid,1))return NYX_AdminDeny(playerid);if(!NYX_AdminFirstId(cmdtext[4],id)||!IsPlayerConnected(id))return SendClientMessage(playerid,COLOR_WARNING,"Uso: /ir [id]");new Float:x,Float:y,Float:z;GetPlayerPos(id,x,y,z);SetPlayerPos(playerid,x+1.5,y+1.5,z);SetPlayerInterior(playerid,GetPlayerInterior(id));SetPlayerVirtualWorld(playerid,GetPlayerVirtualWorld(id));NYX_AdminLog(playerid,id,"/ir","Teleportou-se ate o jogador");return 1;}
    if(!strcmp(cmdtext,"/traz",true,5)){if(!NYX_AdminHas(playerid,1))return NYX_AdminDeny(playerid);if(!NYX_AdminFirstId(cmdtext[6],id)||!IsPlayerConnected(id))return SendClientMessage(playerid,COLOR_WARNING,"Uso: /traz [id]");new Float:x,Float:y,Float:z;GetPlayerPos(playerid,x,y,z);SetPlayerPos(id,x+1.0,y+1.0,z);SetPlayerInterior(id,GetPlayerInterior(playerid));SetPlayerVirtualWorld(id,GetPlayerVirtualWorld(playerid));NYX_AdminLog(playerid,id,"/traz","Trouxe o jogador");return 1;}
    if(!strcmp(cmdtext,"/kick",true,5)){if(!NYX_AdminHas(playerid,1))return NYX_AdminDeny(playerid);if(!NYX_AdminIdReason(cmdtext[6],id,reason,sizeof reason)||!IsPlayerConnected(id))return SendClientMessage(playerid,COLOR_WARNING,"Uso: /kick [id] [motivo]");if(NYX_Player[id][NYX_Admin]>=NYX_Player[playerid][NYX_Admin]&&NYX_Player[playerid][NYX_Admin]<100)return SendClientMessage(playerid,COLOR_ERROR,"Voce nao pode punir administrador igual ou superior.");NYX_AdminLog(playerid,id,"/kick",reason);SetTimerEx("NYX_AdminDelayedKick",100,false,"i",id);return 1;}
    if(!strcmp(cmdtext,"/ban",true,4)){if(!NYX_AdminHas(playerid,1))return NYX_AdminDeny(playerid);if(!NYX_AdminIdReason(cmdtext[5],id,reason,sizeof reason)||!IsPlayerConnected(id))return SendClientMessage(playerid,COLOR_WARNING,"Uso: /ban [id] [motivo]");if(NYX_Player[id][NYX_Admin]>=NYX_Player[playerid][NYX_Admin]&&NYX_Player[playerid][NYX_Admin]<100)return SendClientMessage(playerid,COLOR_ERROR,"Voce nao pode banir administrador igual ou superior.");new path[96],line[160],name[MAX_PLAYER_NAME],File:file;GetPlayerName(id,name,sizeof name);format(path,sizeof path,"scriptfiles/nyx_bans.dat");file=fopen(path,io_append);if(file){format(line,sizeof line,"%s|%d|%s",name,gettime(),reason);fwrite(file,line);fclose(file);}NYX_AdminLog(playerid,id,"/ban",reason);SetTimerEx("NYX_AdminDelayedKick",100,false,"i",id);return 1;}
    if(!strcmp(cmdtext,"/jail",true,5)){if(!NYX_AdminHas(playerid,2))return NYX_AdminDeny(playerid);if(!NYX_AdminIdMinutesReason(cmdtext[6],id,minutes,reason,sizeof reason)||!IsPlayerConnected(id)||minutes<1||minutes>300)return SendClientMessage(playerid,COLOR_WARNING,"Uso: /jail [id] [minutos] [motivo]");if(NYX_Player[id][NYX_Admin]>=NYX_Player[playerid][NYX_Admin]&&NYX_Player[playerid][NYX_Admin]<100)return SendClientMessage(playerid,COLOR_ERROR,"Voce nao pode prender administrador igual ou superior.");NYX_AdminJailPlayer(id,minutes*60,reason);NYX_AdminLog(playerid,id,"/jail",reason);NYX_AdminSave(id);return SendClientMessage(id,COLOR_ERROR,"Voce foi preso administrativamente.");}
    if(!strcmp(cmdtext,"/unjail",true,7)){if(!NYX_AdminHas(playerid,2))return NYX_AdminDeny(playerid);if(!NYX_AdminFirstId(cmdtext[8],id)||!IsPlayerConnected(id))return SendClientMessage(playerid,COLOR_WARNING,"Uso: /unjail [id]");NYX_AdminReleaseJail(id);NYX_AdminLog(playerid,id,"/unjail","Liberou da prisao");NYX_AdminSave(id);return 1;}
    if(!strcmp(cmdtext,"/adv",true,4)){if(!NYX_AdminHas(playerid,1))return NYX_AdminDeny(playerid);if(!NYX_AdminIdReason(cmdtext[5],id,reason,sizeof reason)||!IsPlayerConnected(id))return SendClientMessage(playerid,COLOR_WARNING,"Uso: /adv [id] [motivo]");if(NYX_Player[id][NYX_Admin]>=NYX_Player[playerid][NYX_Admin]&&NYX_Player[playerid][NYX_Admin]<100)return SendClientMessage(playerid,COLOR_ERROR,"Operacao nao permitida.");NYX_AdminWarnings[id]++;format(msg,sizeof msg,"[ADVERTENCIA] Aviso [%d/3]. Motivo: %s",NYX_AdminWarnings[id],reason);SendClientMessage(id,COLOR_ERROR,msg);NYX_AdminLog(playerid,id,"/adv",reason);if(NYX_AdminWarnings[id]>=3){NYX_AdminWarnings[id]=0;NYX_AdminJailPlayer(id,NYX_AUTO_JAIL_SECONDS,"Acumulo de 3 advertencias administrativas");SendClientMessage(id,COLOR_ERROR,"[PRISAO] 3 advertencias acumuladas. Pena: 30 minutos.");NYX_AdminLog(playerid,id,"/auto-jail","3 advertencias acumuladas");}NYX_AdminSave(id);return 1;}
    if(!strcmp(cmdtext,"/unadv",true,6)){if(!NYX_AdminHas(playerid,2))return NYX_AdminDeny(playerid);if(!NYX_AdminFirstId(cmdtext[7],id)||!IsPlayerConnected(id))return SendClientMessage(playerid,COLOR_WARNING,"Uso: /unadv [id]");if(NYX_AdminWarnings[id]<=0)return SendClientMessage(playerid,COLOR_ERROR,"Jogador sem advertencias.");NYX_AdminWarnings[id]--;NYX_AdminLog(playerid,id,"/unadv","Removeu uma advertencia");NYX_AdminSave(id);return 1;}
    if(!strcmp(cmdtext,"/desarmar",true,9)){if(!NYX_AdminHas(playerid,1))return NYX_AdminDeny(playerid);if(!NYX_AdminFirstId(cmdtext[10],id)||!IsPlayerConnected(id))return SendClientMessage(playerid,COLOR_WARNING,"Uso: /desarmar [id]");if(NYX_Player[id][NYX_Admin]>=NYX_Player[playerid][NYX_Admin]&&NYX_Player[playerid][NYX_Admin]<100)return SendClientMessage(playerid,COLOR_ERROR,"Operacao nao permitida.");ResetPlayerWeapons(id);NYX_AdminLog(playerid,id,"/desarmar","Removeu todas as armas");return 1;}
    if(!strcmp(cmdtext,"/curar",true,5)){if(!NYX_AdminHas(playerid,2))return NYX_AdminDeny(playerid);if(!NYX_AdminFirstId(cmdtext[6],id)||!IsPlayerConnected(id))return SendClientMessage(playerid,COLOR_WARNING,"Uso: /curar [id]");SetPlayerHealth(id,100.0);SetPlayerArmour(id,100.0);NYX_AdminLog(playerid,id,"/curar","Vida e colete restaurados");return 1;}
    if(!strcmp(cmdtext,"/godmode",true,8)||!strcmp(cmdtext,"/god",true,4)){if(!NYX_AdminHas(playerid,1))return NYX_AdminDeny(playerid);NYX_AdminGod[playerid]=!NYX_AdminGod[playerid];SetPlayerHealth(playerid,100.0);SetPlayerArmour(playerid,100.0);NYX_AdminLog(playerid,INVALID_PLAYER_ID,"/godmode",NYX_AdminGod[playerid]?"Ativou":"Desativou");return SendClientMessage(playerid,NYX_AdminGod[playerid]?COLOR_SUCCESS:COLOR_WARNING,NYX_AdminGod[playerid]?"Modo Deus ativado.":"Modo Deus desativado.");}
    if(!strcmp(cmdtext,"/invisivel",true,10)||!strcmp(cmdtext,"/inv",true,4)){if(!NYX_AdminHas(playerid,1))return NYX_AdminDeny(playerid);NYX_AdminInvisible[playerid]=!NYX_AdminInvisible[playerid];SetPlayerColor(playerid,NYX_AdminInvisible[playerid]?0xFFFFFF00:0xFFFFFFFF);NYX_AdminLog(playerid,INVALID_PLAYER_ID,"/invisivel",NYX_AdminInvisible[playerid]?"Ativou marcador invisivel":"Desativou marcador invisivel");return 1;}
    if(!strcmp(cmdtext,"/visivel",true,8)){if(!NYX_AdminHas(playerid,1))return NYX_AdminDeny(playerid);NYX_AdminInvisible[playerid]=false;SetPlayerColor(playerid,0xFFFFFFFF);return 1;}
    if(!strcmp(cmdtext,"/freeze",true,7)){if(!NYX_AdminHas(playerid,1))return NYX_AdminDeny(playerid);if(!NYX_AdminFirstId(cmdtext[8],id)||!IsPlayerConnected(id))return SendClientMessage(playerid,COLOR_WARNING,"Uso: /freeze [id]");TogglePlayerControllable(id,0);NYX_AdminFrozen[id]=true;NYX_AdminLog(playerid,id,"/freeze","Congelou jogador");return 1;}
    if(!strcmp(cmdtext,"/unfreeze",true,9)){if(!NYX_AdminHas(playerid,1))return NYX_AdminDeny(playerid);if(!NYX_AdminFirstId(cmdtext[10],id)||!IsPlayerConnected(id))return SendClientMessage(playerid,COLOR_WARNING,"Uso: /unfreeze [id]");TogglePlayerControllable(id,1);NYX_AdminFrozen[id]=false;NYX_AdminLog(playerid,id,"/unfreeze","Descongelou jogador");return 1;}
    if(!strcmp(cmdtext,"/limparchat",true,11)||!strcmp(cmdtext,"/cc",true,3)){if(!NYX_AdminHas(playerid,1))return NYX_AdminDeny(playerid);for(new i=0;i<60;i++)SendClientMessageToAll(-1," ");NYX_AdminLog(playerid,INVALID_PLAYER_ID,"/limparchat","Limpou o chat global");return 1;}
    if(!strcmp(cmdtext,"/setadmin",true,9)){if(!NYX_AdminHas(playerid,100))return NYX_AdminDeny(playerid);if(!NYX_AdminFirstId(cmdtext[10],id))return SendClientMessage(playerid,COLOR_WARNING,"Uso: /setadmin [id] [nivel]");new tail[32];if(!NYX_AdminTail(cmdtext[10],tail,sizeof tail))return SendClientMessage(playerid,COLOR_WARNING,"Uso: /setadmin [id] [nivel]");new level=strval(tail);if(!IsPlayerConnected(id)||id==playerid)return SendClientMessage(playerid,COLOR_ERROR,"Jogador invalido.");if(!(level==0||level==1||level==2||level==3||level==4||level==5||level==6||level==7||level==80||level==100))return SendClientMessage(playerid,COLOR_ERROR,"Nivel administrativo invalido.");NYX_Player[id][NYX_Admin]=level;NYX_AdminLog(playerid,id,"/setadmin","Nivel alterado");NYX_AdminSave(id);format(msg,sizeof msg,"Seu nivel administrativo agora e %d.",level);return SendClientMessage(id,COLOR_SUCCESS,msg);}
    if(!strcmp(cmdtext,"/clima",true,6)){if(!NYX_AdminHas(playerid,2))return NYX_AdminDeny(playerid);new w=strval(cmdtext[7]);if(w<0||w>45)return SendClientMessage(playerid,COLOR_WARNING,"Uso: /clima [0-45]");SetWeather(w);NYX_AdminLog(playerid,INVALID_PLAYER_ID,"/clima","Clima alterado");return 1;}
    if(!strcmp(cmdtext,"/hora",true,5)){if(!NYX_AdminHas(playerid,2))return NYX_AdminDeny(playerid);new h=strval(cmdtext[6]);if(h<0||h>23)return SendClientMessage(playerid,COLOR_WARNING,"Uso: /hora [0-23]");SetWorldTime(h);NYX_AdminLog(playerid,INVALID_PLAYER_ID,"/hora","Hora alterada");return 1;}
    if(!strcmp(cmdtext,"/payday",true,7)){new left=NYX_PAYDAY_SECONDS-NYX_PaydayTime[playerid];if(left<0)left=0;format(msg,sizeof msg,"[PAYDAY] Faltam %d minuto(s) e %d segundo(s) para o proximo salario.",left/60,left%60);return SendClientMessage(playerid,COLOR_WARNING,msg);}
    if(!strcmp(cmdtext,"/status",true,7)&&NYX_AdminJail[playerid]>0){format(msg,sizeof msg,"[PRISAO] Tempo restante: %d minuto(s) e %d segundo(s) | Motivo: %s",NYX_AdminJail[playerid]/60,NYX_AdminJail[playerid]%60,NYX_AdminJailReason[playerid]);return SendClientMessage(playerid,COLOR_WARNING,msg);}
